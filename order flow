//@version=6
indicator("Contrainteligencia de Mercado v6 - Final Pro", overlay=false, max_labels_count=500, max_lines_count=500)

// ==========================
// Inputs de Filtrado
// ==========================
string ltfTf = input.timeframe("1", "LTF intrabarra")
int pivotLen = input.int(8, "Sensibilidad de Liquidez", minval=3)
float volFilterMult = input.float(1.8, "Filtro Vol. para Niveles", minval=1.0, tooltip="Solo dibuja si el volumen supera el promedio por este múltiplo. Sube el valor para ver menos zonas.")
float imbalanceRatio = input.float(2.2, "Ratio imbalance (x:1)", minval=1.2)
int maxLines = input.int(20, "Máximo de líneas en pantalla", minval=5)
bool useVolFilter = input.bool(true, "Aplicar filtro de volumen")
bool showLiquidity = input.bool(true, "Mostrar zonas moradas")
bool showWalls = input.bool(true, "Mostrar zonas amarillas")
int cooldownBars = input.int(8, "Separación mínima entre nuevas líneas (barras)", minval=1)
float minGapAtr = input.float(0.25, "Separación mínima por precio (x ATR)", minval=0.01, maxval=2.0, step=0.01)
bool debugMarks = input.bool(false, "Mostrar marcas de depuración")

// Colores
color AMARILLO = #FFFF00
color MORADO   = #8000FF
color VERDE    = #00FF00
color ROJO     = #FF0000
color BLANCO   = #FFFFFF

// ==========================
// Order Flow & Delta
// ==========================
array<float> ltfOpen  = request.security_lower_tf(syminfo.tickerid, ltfTf, open)
array<float> ltfClose = request.security_lower_tf(syminfo.tickerid, ltfTf, close)
array<float> ltfVol   = request.security_lower_tf(syminfo.tickerid, ltfTf, volume)

float buyFlow = 0.0, sellFlow = 0.0, maxLtfVol = 0.0, wallPrice = close

if array.size(ltfVol) > 0
    for i = 0 to array.size(ltfVol) - 1
        float o = array.get(ltfOpen, i)
        float c = array.get(ltfClose, i)
        float v = array.get(ltfVol, i)
        if c > o
            buyFlow += v
        else if c < o
            sellFlow += v
        else
            buyFlow  += v * 0.5
            sellFlow += v * 0.5

        if v >= maxLtfVol
            maxLtfVol := v
            wallPrice := c
else
    buyFlow  := close >= open ? volume : volume * 0.5
    sellFlow := close < open ? volume : volume * 0.5

float deltaFlow = buyFlow - sellFlow
float avgVol = ta.sma(volume, 50)

// Filtro robusto (si el promedio aún no existe, no bloquea)
bool volPassNow = na(avgVol) ? true : volume > (avgVol * volFilterMult)
bool isSignificantNow = useVolFilter ? volPassNow : true

// ==========================
// Niveles Representativos (Líneas en Overlay)
// ==========================
var line[] liquidityLines = array.new_line()
var line[] wallLines = array.new_line()
var int lastLiquidityBar = na
var int lastWallBar = na

float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)
float atr = ta.atr(14)
float minGap = atr * minGapAtr

// Para pivotes, evaluamos volumen en la barra del pivote, no en la barra actual
float avgVolPivot = avgVol[pivotLen]
bool volPassPivot = na(avgVolPivot) ? true : volume[pivotLen] > (avgVolPivot * volFilterMult)
bool isSignificantPivot = useVolFilter ? volPassPivot : true

canAddAtPrice(line[] linesArr, float price, float gap) =>
    bool allow = true
    if array.size(linesArr) > 0
        for i = 0 to array.size(linesArr) - 1
            line ln = array.get(linesArr, i)
            float y = line.get_y1(ln)
            if math.abs(y - price) <= gap
                allow := false
                break
    allow

bool liquidityCooldownOk = na(lastLiquidityBar) or bar_index - lastLiquidityBar >= cooldownBars

if showLiquidity and not na(ph) and isSignificantPivot and liquidityCooldownOk and canAddAtPrice(liquidityLines, ph, minGap)
    line l = line.new(
         bar_index - pivotLen, ph,
         bar_index, ph,
         color=MORADO, width=2, extend=extend.right, force_overlay=true)
    array.push(liquidityLines, l)
    if array.size(liquidityLines) > maxLines
        line.delete(array.shift(liquidityLines))
    lastLiquidityBar := bar_index

liquidityCooldownOk := na(lastLiquidityBar) or bar_index - lastLiquidityBar >= cooldownBars

if showLiquidity and not na(pl) and isSignificantPivot and liquidityCooldownOk and canAddAtPrice(liquidityLines, pl, minGap)
    line l = line.new(
         bar_index - pivotLen, pl,
         bar_index, pl,
         color=MORADO, width=2, extend=extend.right, force_overlay=true)
    array.push(liquidityLines, l)
    if array.size(liquidityLines) > maxLines
        line.delete(array.shift(liquidityLines))
    lastLiquidityBar := bar_index

bool wallImbalance = buyFlow > sellFlow * imbalanceRatio or sellFlow > buyFlow * imbalanceRatio
bool wallCond = wallImbalance and isSignificantNow
bool wallCooldownOk = na(lastWallBar) or bar_index - lastWallBar >= cooldownBars

if showWalls and wallCond and wallCooldownOk and canAddAtPrice(wallLines, wallPrice, minGap)
    line l = line.new(
         bar_index, wallPrice,
         bar_index + 1, wallPrice,
         color=AMARILLO, width=2, extend=extend.right, force_overlay=true)
    array.push(wallLines, l)
    if array.size(wallLines) > maxLines
        line.delete(array.shift(wallLines))
    lastWallBar := bar_index

// Marcas opcionales para validar cuándo se activan las zonas
plotshape(debugMarks and not na(ph) and isSignificantPivot, title="Pivot High OK", style=shape.circle, size=size.tiny, color=MORADO, location=location.top)
plotshape(debugMarks and not na(pl) and isSignificantPivot, title="Pivot Low OK", style=shape.circle, size=size.tiny, color=MORADO, location=location.bottom)
plotshape(debugMarks and wallCond, title="Wall OK", style=shape.triangleup, size=size.tiny, color=AMARILLO, location=location.top)

// ==========================
// Panel Inferior: Histogramas y Delta
// ==========================
plot(buyFlow, title="Buy Flow", color=VERDE, style=plot.style_histogram, linewidth=2)
plot(-sellFlow, title="Sell Flow", color=ROJO, style=plot.style_histogram, linewidth=2)
plot(deltaFlow, title="Delta Line", color=BLANCO, linewidth=2)
plot(0, title="Zero Line", color=color.new(BLANCO, 50))

// ==========================
// ETIQUETAS DE DATOS (Up, Dn, Delta)
// ==========================
var label lblData = na
if barstate.islast
    string txt = "UP: " + str.tostring(buyFlow, format.volume) +
                 "\nDN: " + str.tostring(sellFlow, format.volume) +
                 "\nΔ: " + str.tostring(deltaFlow, format.volume)

    if na(lblData)
        lblData := label.new(
             bar_index, 0, txt,
             color=color.new(color.black, 100),
             textcolor=BLANCO,
             style=label.style_label_left,
             size=size.small)
    else
        label.set_xy(lblData, bar_index, 0)
        label.set_text(lblData, txt)